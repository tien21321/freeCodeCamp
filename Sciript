local function makeLabel(y, txt)
    local lbl = Instance.new("TextLabel", frame)
    lbl.Position = UDim2.new(0,16,0,y)
    lbl.Size = UDim2.new(0,160,0,30)
    lbl.BackgroundTransparency = 1
    lbl.Text = txt
    lbl.TextColor3 = Color3.fromRGB(220,220,220)
    lbl.Font = Enum.Font.SourceSans
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    return lbl
end

local function makeTextbox(y, placeholder)
    local box = Instance.new("TextBox", frame)
    box.Position = UDim2.new(0,180,0,y)
    box.Size = UDim2.new(0,160,0,30)
    box.Text = ""
    box.PlaceholderText = placeholder
    box.ClearTextOnFocus = false
    box.Font = Enum.Font.SourceSans
    box.TextSize = 14
    box.TextColor3 = Color3.fromRGB(0,0,0)
    local bg = Instance.new("UICorner", box)
    bg.CornerRadius = UDim.new(0,6)
    return box
end

