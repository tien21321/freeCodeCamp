-- Highlight helper
local currentHighlight = nil
local function clearHighlight()
    if currentHighlight and currentHighlight.Parent then
        currentHighlight:Destroy()
    end
    currentHighlight = nil
end

local function highlightPlayer(targetPlayer)
    clearHighlight()
    if not targetPlayer or not targetPlayer.Character then return end
    local char = targetPlayer.Character
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
    if not hrp then return end

    -- Tạo SelectionBox gắn lên head (an toàn, client-side)
    local sel = Instance.new("SelectionBox")
    sel.Adornee = hrp
    sel.Parent = workspace
    sel.LineThickness = 0.03
    currentHighlight = sel

    -- tự động clear sau 8 giây
    delay(8, clearHighlight)
end

-- Áp dụng cấu hình
applyBtn.MouseButton1Click:Connect(function()
    -- Speed
    local speedNum = tonumber(speedBox.Text)
    if speedNum and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = speedNum
    end

    -- JumpPower
    local jumpNum = tonumber(jumpBox.Text)
    if jumpNum and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").JumpPower = jumpNum
    end

    -- Target highlight (AN TOÀN: chỉ highlight)
    local targetName = targetBox.Text
    if targetName and targetName ~= "" then
        local targetPlayer = Players:FindFirstChild(targetName)
        if targetPlayer then
            highlightPlayer(targetPlayer)
        else
            -- Thông báo nhỏ
            local old = applyBtn.Text
            applyBtn.Text = "Không tìm thấy người chơi"
            wait(1.6)
            applyBtn.Text = old
        end
    end
end)

-- Reset khi respawn
LocalPlayer.CharacterAdded:Connect(function(char)
    wait(0.5)
    -- reset WalkSpeed & JumpPower sang mặc định (nếu muốn)
    local hum = char:WaitForChild("Humanoid", 2)
    if hum then
        hum.WalkSpeed = 16
        hum.JumpPower = 50
    end
end)

